@page "/login"
@layout EmptyLayout

<PageTitle>Sign in · OneZero ERP</PageTitle>
<div class="login-page"><div class="login-panel"><div class="brand brand--login"><span class="brand-mark">0Z</span><span>OneZero <small>ERP</small></span></div><div class="eyebrow">Secure workspace</div><h1>Welcome back</h1><p class="page-subtitle">Sign in to continue to your ERP workspace.</p>@if (Error) { <div class="validation-message" role="alert">Sign-in failed. Check your credentials or ask an administrator to enable your account.</div> }<form method="post" action="/account/login" class="login-form"><AntiforgeryToken /><label>Username<input name="UserName" autocomplete="username" required /></label><label>Password<span class="password-field"><input id="login-password" name="Password" type="password" autocomplete="current-password" required /><button type="button" class="password-toggle" aria-label="Show password" title="Show password" aria-pressed="false" onclick="oneZeroPassword.toggle('login-password', this)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12s3.4-6 9.5-6 9.5 6 9.5 6-3.4 6-9.5 6-9.5-6-9.5-6Z"/><circle cx="12" cy="12" r="2.5"/></svg></button></span></label><button class="button button--primary button--full" type="submit">Sign in</button></form><p class="login-note">Development users are configured through environment secrets.</p></div></div>
@code { [SupplyParameterFromQuery] public int? error { get; set; } private bool Error => error is 1; }
