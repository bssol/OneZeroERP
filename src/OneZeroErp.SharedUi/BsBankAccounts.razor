<EntityDropdown TItem="BankAccountListItem" TValue="Guid"
                Items="@SelectableItems" Value="@Value" ValueChanged="@ValueChanged" ItemSelected="@ItemSelected"
                ValueSelector="@(item => item.Id)" TextSelector="@(item => $"{item.Code} — {item.Name} · {item.BankName} · {item.AccountNumber}")"
                Placeholder="@Placeholder" SearchPlaceholder="Search bank account..."
                SearchAriaLabel="Search bank accounts" AriaLabel="Bank accounts" NoResultsText="No matching bank accounts."
                Disabled="@Disabled" DebounceMilliseconds="@DebounceMilliseconds" CssClass="@CssClass" />

@code {
    [Parameter, EditorRequired] public IReadOnlyList<BankAccountListItem> Items { get; set; } = Array.Empty<BankAccountListItem>();
    [Parameter] public Guid Value { get; set; }
    [Parameter] public EventCallback<Guid> ValueChanged { get; set; }
    [Parameter] public EventCallback<BankAccountListItem> ItemSelected { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Select bank account";
    [Parameter] public string CssClass { get; set; } = string.Empty;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool IncludeInactive { get; set; }
    [Parameter] public int DebounceMilliseconds { get; set; } = 250;
    private IReadOnlyList<BankAccountListItem> SelectableItems => Items.Where(item => IncludeInactive || item.IsActive || item.Id == Value).ToArray();
}
