@typeparam TItem

<section class="entity-grid" aria-label="Data grid">
    <div class="entity-grid__scroll">
        <table>
            <thead><tr>@HeaderTemplate @if (ActionsTemplate is not null) { <th scope="col">Actions</th> }</tr></thead>
            <tbody>
                @foreach (var item in Items)
                {
                    <tr>@RowTemplate(item) @if (ActionsTemplate is not null) { <td class="entity-grid__actions">@ActionsTemplate(item)</td> }</tr>
                }
            </tbody>
        </table>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<TItem> Items { get; set; } = Array.Empty<TItem>();
    [Parameter] public RenderFragment? HeaderTemplate { get; set; }
    [Parameter, EditorRequired] public RenderFragment<TItem> RowTemplate { get; set; } = default!;
    [Parameter] public RenderFragment<TItem>? ActionsTemplate { get; set; }
}