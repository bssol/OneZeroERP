<EntityDropdown TItem="VoucherTypeListItem" TValue="Guid"
                Items="@SelectableItems" Value="@Value" ValueChanged="@ValueChanged" ItemSelected="@ItemSelected"
                ValueSelector="@(item => item.Id)" TextSelector="@(item => $"{item.Code} — {item.Description}")"
                Placeholder="@Placeholder" SearchPlaceholder="Search voucher type..."
                SearchAriaLabel="Search voucher types" AriaLabel="Voucher types" NoResultsText="No matching voucher types."
                Disabled="@Disabled" DebounceMilliseconds="@DebounceMilliseconds" CssClass="@CssClass" />

@code {
    [Parameter, EditorRequired] public IReadOnlyList<VoucherTypeListItem> Items { get; set; } = Array.Empty<VoucherTypeListItem>();
    [Parameter] public Guid Value { get; set; }
    [Parameter] public EventCallback<Guid> ValueChanged { get; set; }
    [Parameter] public EventCallback<VoucherTypeListItem> ItemSelected { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Select voucher type";
    [Parameter] public string CssClass { get; set; } = string.Empty;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool IncludeInactive { get; set; }
    [Parameter] public int DebounceMilliseconds { get; set; } = 250;
    private IReadOnlyList<VoucherTypeListItem> SelectableItems => Items.Where(item => IncludeInactive || item.IsActive || item.Id == Value).ToArray();
}
